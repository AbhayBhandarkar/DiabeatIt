# Optional consent-gated food identification. Set privately on the server, never in VITE_*.
# OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-4.1-mini
# Photo AI suggests identities/rough grams only, not exact nutrition or medical decisions.
# Local development only: keep the embedded database outside cloud-synced folders.
# PGLITE_DATA_DIR=C:/Users/your-name/AppData/Local/DiabeatIT/data
# Production additionally requires HTTPS APP_ORIGIN, COOKIE_SECURE=true,
# DATABASE_URL and SCHEMA_READY=true after npm run db:migrate.
# Setting these is not clinical/security certification; see docs/RELEASE-PLAN.md.
# Engineering prototype, not a clinical release. Use synthetic test records.
# Documentation only: npm start/dev do NOT automatically load this file.
# Supply process environment variables through your shell/host or Node env-file support.
HOST=127.0.0.1
PORT=3001
# Built app origin; use http://127.0.0.1:5173 for Vite development.
APP_ORIGIN=http://127.0.0.1:3001
# Local HTTP only. Hosted HTTPS requires COOKIE_SECURE=true and its exact APP_ORIGIN.
# Account cookies are also automatically Secure when NODE_ENV=production.
COOKIE_SECURE=false
# Optional external PostgreSQL; otherwise embedded PGlite persists in .data/diabeatit.
# Never run two API processes against the same embedded database directory.
# DATABASE_URL=postgresql://user:password@localhost:5432/diabeatit
# Optional, server-side only: USDA FoodData Central for food TEXT search.
# Without a key, text search uses OpenFoodFacts; barcode search always uses OpenFoodFacts.
# Never commit a real key or put it in a VITE_* variable.
# FDC_API_KEY=
# DEMO_ENABLED is a legacy demo setting, not an account-app access control.
# --- AI (server-side only; see README section 5) ---
# AI_PROVIDER=groq            # groq | openai-compatible | disabled
# GROQ_API_KEY=
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_TEXT_MODEL=qwen/qwen3.8-27b
# AI_VISION_MODEL=qwen/qwen3.8-27b
# AI_FALLBACK_TEXT_MODEL=openai/gpt-oss-20b
# AI_REASONING_EFFORT=none
# AI_TIMEOUT_MS=30000

