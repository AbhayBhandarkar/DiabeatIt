        {
          "startSeconds": 40,
          "endSeconds": 48,
          "title": "Know the limits"
        }
      ],
      "checkpoints": [
        {
          "id": "uncertainty-check",
          "atSeconds": 31,
          "prompt": "The log is empty and the person cannot remember. Which record is supported?",
          "choices": [
            {
              "id": "missed",
              "text": "Definitely missed",
              "feedback": "A missing entry does not prove a missed medicine. Keep the uncertainty visible."
            },
            {
              "id": "taken",
              "text": "Definitely taken",
              "feedback": "There is not enough evidence to mark it taken. Preserve the person's uncertainty."
            },
            {
              "id": "unsure",
              "text": "Unsure — include source and time",
              "feedback": "Yes. Record what is known without inventing certainty. Seek professional guidance, not an app-generated dose decision."
            }
          ],
          "correctChoiceId": "unsure",
          "pausePlayback": true,
          "resumeAtSeconds": 32,
          "replayFromSeconds": 24
        }
      ],
      "cues": [
        {
          "startSeconds": 0.65,
          "endSeconds": 3.732,
          "text": "A reminder was sent, but the log is empty."
        },
        {
          "startSeconds": 3.732,
          "endSeconds": 6.813,
          "text": "That does not establish whether a medicine was taken."
        },
        {
          "startSeconds": 8.65,
          "endSeconds": 12.379,
          "text": "Reminders, reports, and actual intake are different things. Keep"
        },
        {
          "startSeconds": 12.379,
          "endSeconds": 15.278,
          "text": "the time and source of reports visible."
        },
        {
          "startSeconds": 16.65,
          "endSeconds": 20.122,
          "text": "If memory and records disagree, preserve the uncertainty. An"
        },
        {
          "startSeconds": 20.122,
          "endSeconds": 23.593,
          "text": "app entry is not proof that medicine was swallowed."
        },
        {
          "startSeconds": 24.65,
          "endSeconds": 28.799,
          "text": "Checkpoint. No entry, and the person is unsure. What"
        },
        {
          "startSeconds": 28.799,
          "endSeconds": 30.644,
          "text": "should the record say?"
        },
        {
          "startSeconds": 32.65,
          "endSeconds": 36.696,
          "text": "Record unsure, with source and time. Ask a pharmacist"
        },
        {
          "startSeconds": 36.696,
          "endSeconds": 38.944,
          "text": "about uncertainty, not an app."
        },
        {
          "startSeconds": 40.65,
          "endSeconds": 44.104,
          "text": "For suspected overdose or severe symptoms, seek urgent local"
        },
        {
          "startSeconds": 44.104,
          "endSeconds": 47.558,
          "text": "medical help. Do not wait for an app review."
        }
      ],
