          "endSeconds": 8,
          "title": "Find the reference amount"
        },
        {
          "startSeconds": 8,
          "endSeconds": 16,
          "title": "Compare with your portion"
        },
        {
          "startSeconds": 16,
          "endSeconds": 24,
          "title": "Scale the same nutrient"
        },
        {
          "startSeconds": 24,
          "endSeconds": 32,
          "title": "Your checkpoint"
        },
        {
          "startSeconds": 32,
          "endSeconds": 40,
          "title": "Reveal the arithmetic"
        },
        {
          "startSeconds": 40,
          "endSeconds": 48,
          "title": "A reference, not a prescription"
        }
      ],
      "checkpoints": [
        {
          "id": "portion-check",
          "atSeconds": 31,
          "prompt": "12 g carbohydrate per 30 g serving: how much is in a 60 g portion?",
          "choices": [
            {
              "id": "12",
              "text": "12 g",
              "feedback": "12 g is for one 30 g serving. This 60 g portion contains two servings."
            },
            {
              "id": "24",
              "text": "24 g",
              "feedback": "Correct: 60 ÷ 30 = 2 servings, then 12 × 2 = 24 g carbohydrate. This is label arithmetic, not a glucose prediction."
            },
            {
              "id": "60",
              "text": "60 g",
              "feedback": "60 g is the whole food's mass, not its carbohydrate amount. Multiply the carbohydrate per serving by two."
            }
          ],
          "correctChoiceId": "24",
          "pausePlayback": true,
          "resumeAtSeconds": 32,
          "replayFromSeconds": 24
        }
      ],
      "cues": [
        {
          "startSeconds": 0.65,
          "endSeconds": 4.244,
          "text": "This fictional label lists twelve grams of carbohydrate per"
        },
        {
          "startSeconds": 4.244,
          "endSeconds": 7.438,
          "text": "thirty gram serving. Start with that reference amount."
        },
        {
          "startSeconds": 8.65,
          "endSeconds": 12.409,
          "text": "The portion shown weighs sixty grams. Dividing sixty by"
        },
        {
          "startSeconds": 12.409,
          "endSeconds": 15.333,
          "text": "thirty gives two label servings, not one."
        },
        {
          "startSeconds": 16.65,
          "endSeconds": 20.525,
          "text": "Each serving has twelve grams of carbohydrate. Two equal"
        },
        {
          "startSeconds": 20.525,
          "endSeconds": 22.678,
          "text": "servings contain twice that amount."
        },
        {
          "startSeconds": 24.65,
          "endSeconds": 29.063,
          "text": "Twelve grams per serving. How much in two servings?"
        },
        {
          "startSeconds": 29.063,
          "endSeconds": 30.044,
          "text": "Choose now."
        },
        {
          "startSeconds": 32.65,
          "endSeconds": 36.392,
          "text": "Twelve times two equals twenty four grams. These invented"
        },
        {
          "startSeconds": 36.392,
          "endSeconds": 39.718,
          "text": "numbers explain the method, not a particular food."
        },
        {
          "startSeconds": 40.65,
          "endSeconds": 44.196,
          "text": "Serving size is not a recommendation. Check for per"
        },
        {
          "startSeconds": 44.196,
          "endSeconds": 46.953,
          "text": "serving, per package, or per hundred grams."
        }
      ],
      "sources": [
        {
          "id": "fda-label",
