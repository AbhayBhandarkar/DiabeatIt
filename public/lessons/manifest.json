      ],
      "cues": [
        {
          "startSeconds": 0.65,
          "endSeconds": 4.384,
          "text": "Different medicine names can hide a shared active ingredient."
        },
        {
          "startSeconds": 4.384,
          "endSeconds": 7.288,
          "text": "These boxes are fictional, not real medicines."
        },
        {
          "startSeconds": 8.65,
          "endSeconds": 13.539,
          "text": "Read every ingredient. A combination product contains several. Both"
        },
        {
          "startSeconds": 13.539,
          "endSeconds": 15.168,
          "text": "boxes list X."
        },
        {
          "startSeconds": 16.65,
          "endSeconds": 20.883,
          "text": "A shared ingredient flags possible overlap. It does not"
        },
        {
          "startSeconds": 20.883,
          "endSeconds": 22.294,
          "text": "decide medicine changes."
        },
        {
          "startSeconds": 24.65,
          "endSeconds": 28.439,
          "text": "Both boxes list X. What does that tell you?"
        },
        {
          "startSeconds": 32.65,
          "endSeconds": 37.072,
          "text": "Possible overlap needs a pharmacist or prescriber's clarification. This"
        },
        {
          "startSeconds": 37.072,
          "endSeconds": 39.528,
          "text": "lesson cannot decide medicine changes."
        },
        {
          "startSeconds": 40.65,
          "endSeconds": 45.621,
          "text": "Bring packaging and prescriptions. Explain actual use. This is"
        },
        {
          "startSeconds": 45.621,
          "endSeconds": 47.278,
          "text": "general education only."
        }
      ],
