      "checkpoints": [
        {
          "id": "overlap-check",
          "atSeconds": 31,
          "prompt": "Two different boxes both list ingredient X. What can you conclude?",
          "choices": [
            {
              "id": "review",
              "text": "Possible overlap; professional clarification needed.",
              "feedback": "Yes. A shared ingredient is a review flag, not a decision to stop, combine, or change medicines."
            },
            {
              "id": "different",
              "text": "Different brand names rule out overlap.",
              "feedback": "Names alone do not rule out overlap. Compare all active ingredients and ask for professional clarification."
            },
            {
              "id": "identical",
              "text": "The two products must be interchangeable.",
              "feedback": "A shared ingredient does not establish interchangeability. Strength, formulation, and instructions also matter."
            }
          ],
          "correctChoiceId": "review",
          "pausePlayback": true,
          "resumeAtSeconds": 32,
          "replayFromSeconds": 24
