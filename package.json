{
  "name": "diabeatit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "start:local": "tsx --env-file=.env server/index.ts",
    "seed:showcase": "node scripts/seed-showcase.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test -c playwright.product.config.ts",
    "test:e2e:legacy": "playwright test -c playwright.config.ts",
    "check": "npm run build && npm test",
    "icons": "node scripts/icons.mjs",
    "db:migrate": "tsx server/migrate.ts",
    "assets:recipes": "node scripts/recipe-photos.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/outfit": "^5.2.8",
    "@vitejs/plugin-react": "^4.7.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "sharp": "^0.35.5",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^6.4.1",
    "vitest": "^4.1.12"
  }
}
